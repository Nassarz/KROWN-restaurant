{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "status"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin", "manager", "staff"] },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "restaurantId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] }
      },
      "required": ["role", "email"]
    },
    "Ingredient": {
      "title": "Ingredient",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "stock": { "type": "number" },
        "unit": { "type": "string" },
        "lowStockThreshold": { "type": "number" },
        "restaurantId": { "type": "string" }
      },
      "required": ["name", "stock", "restaurantId"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "available": { "type": "boolean" },
        "restaurantId": { "type": "string" },
        "recipe": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredientId": { "type": "string" },
              "quantity": { "type": "number" }
            }
          }
        }
      },
      "required": ["name", "price", "category", "restaurantId"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["pending", "preparing", "ready", "served", "cancelled"] },
        "total": { "type": "number" },
        "tax": { "type": "number" },
        "type": { "type": "string", "enum": ["Dine In", "Take Away", "Delivery"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "restaurantId": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["status", "total", "type", "createdAt", "restaurantId"]
    }
  },
  "firestore": {
    "restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Restaurant branches"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "ingredients/{ingredientId}": {
      "schema": { "$ref": "#/entities/Ingredient" },
      "description": "Inventory ingredients"
    },
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Menu items"
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "audit_logs/{logId}": {
      "schema": { "type": "object" },
      "description": "Immutable audit logs"
    }
  }
}
